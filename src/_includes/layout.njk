<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ site.title }}</title>
    <meta name="description" content="{{ site.description }}" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="canonical" href="{{ site.url }}" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{{ site.title }}" />
    <meta property="og:description" content="{{ site.description }}" />
    <meta property="og:url" content="{{ site.url }}" />
  </head>
  <body>
    <a class="usa-skipnav" href="#main-content">Skip to main content</a>

    <!-- TODO: fix color on this -->
    <section class="usa-banner section-class">
        <div data-testid="gridContainer" class="grid-container padding-y-1 line-height-sans-1">
          <span class="usa-banner__header-text">
            This is not an official government website. Views expressed here represent the personal opinions of members of the USWDS community. Styled with the <a href="https://designsystem.digital.gov/">U.S. Web Design System</a>, which is the subject of the letter.
          </span>
        </div>
    </section>


    <!-- TODO: Fix color on this too to blue like 18f.org -->
    <header class="site-header">
      <div class="grid-container">
        <div class="grid-row">
          <div class="grid-col-fill">
            <h1 class="site-header__title margin-top-0">
              {{ site.title }}
            </h1>
          </div>
        </div>
      </div>
    </header>

    <nav class="site-nav" aria-label="Primary">
      <div class="grid-container">
        <ul class="site-nav__list">
          <li class="site-nav__item">
            <a class="site-nav__link{% if page.url == '/' %} site-nav__link--current{% endif %}"
               href="/"
               {% if page.url == '/' %}aria-current="page"{% endif %}>Letter</a>
          </li>
          <li class="site-nav__item">
            <a class="site-nav__link{% if page.url == '/about/' %} site-nav__link--current{% endif %}"
               href="/about/"
               {% if page.url == '/about/' %}aria-current="page"{% endif %}>About</a>
          </li>
          <li class="site-nav__item">
            <a class="site-nav__link{% if page.url == '/sign/' %} site-nav__link--current{% endif %}"
               href="/sign/"
               {% if page.url == '/sign/' %}aria-current="page"{% endif %}>Sign</a>
          </li>
        </ul>
      </div>
    </nav>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="grid-container site-footer__grid">
        <div class="grid-row">
          <div class="grid-col-12 tablet:grid-col-8">
            <p class="site-footer__note usa-prose">
              This is a community effort by private citizens. Adding your name
              does not imply your employer endorses this letter. The
              <a class="usa-link" href="{{ site.repoUrl }}/blob/main/CONTRIBUTING.md">contributing guide</a>
              explains how to sign.
            </p>
          </div>

        </div>
      </div>
    </footer>
  </body>
</html>
